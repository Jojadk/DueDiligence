# Application
APP_NAME="DueDiligence"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost

# Database
DB_DRIVER=pgsql
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=duediligence
DB_USERNAME=postgres
DB_PASSWORD=

# Security
APP_KEY=
JWT_SECRET=

# Session
SESSION_LIFETIME=120
SESSION_DRIVER=file

# Cache
CACHE_DRIVER=file

# Mail (optional)
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@duediligence.local
MAIL_FROM_NAME="${APP_NAME}"

# File Upload
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=jpg,jpeg,png,pdf,doc,docx,xls,xlsx

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_ATTEMPTS=60
RATE_LIMIT_DECAY_MINUTES=1

# Logging
LOG_LEVEL=debug
LOG_CHANNEL=daily
