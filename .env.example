# DueDiligence Environment Configuration

# Database Configuration
# Supported values: mysql, pgsql
# MySQL is the default for maximum compatibility
DB_TYPE=mysql

# MySQL Configuration (default)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=duediligence
DB_USER=root
DB_PASS=

# PostgreSQL Configuration (alternative)
# Uncomment and set DB_TYPE=pgsql to use PostgreSQL
# DB_TYPE=pgsql
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=duediligence
# DB_USER=postgres
# DB_PASS=

# Application Settings
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost

# Security
SESSION_LIFETIME=7200
MAX_LOGIN_ATTEMPTS=5
LOGIN_TIMEOUT=900

# File Upload
MAX_UPLOAD_SIZE=10485760
